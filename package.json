{
  "name": "mod-sync-steamos",
  "version": "0.10.0",
  "private": true,
  "description": "Reusable mod-pack deployment for Windows and SteamOS. Mods only in v1.",
  "author": "Winde",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/electron/main.js",
  "bin": {
    "modsync": "bin/modsync.js"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{ recursive: true, force: true });for (const d of ['web/pc','web/tv']) fs.rmSync(d,{ recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && npm run build:web-pc && npm run build:web-tv",
    "build:web-pc": "vite build --config web-pc/vite.config.mjs",
    "build:web-tv": "vite build --config web-tv/vite.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web-pc.json --noEmit && tsc -p tsconfig.web-tv.json --noEmit",
    "prestart": "npm run build",
    "start": "node bin/modsync.js",
    "preelectron": "npm run build",
    "electron": "electron .",
    "predev": "npm run build",
    "dev": "electron . --devtools",
    "predev:server": "npm run build",
    "dev:server": "electron . --devtools --server",
    "predev:client": "npm run build",
    "dev:client": "electron . --devtools --client",
    "prebuild:server:win": "npm run build",
    "build:server:win": "electron-builder --config electron-builder.server.yml --win nsis",
    "prebuild:server:linux": "npm run build",
    "build:server:linux": "electron-builder --config electron-builder.server.yml --linux AppImage",
    "prebuild:client:win": "npm run build",
    "build:client:win": "electron-builder --config electron-builder.client.yml --win nsis",
    "prebuild:client:linux": "npm run build",
    "build:client:linux": "electron-builder --config electron-builder.client.yml --linux AppImage",
    "prebuild:dir:server": "npm run build",
    "build:dir:server": "electron-builder --config electron-builder.server.yml --dir",
    "prebuild:dir:client": "npm run build",
    "build:dir:client": "electron-builder --config electron-builder.client.yml --dir",
    "build:linux": "npm run build:client:linux",
    "build:win": "npm run build:server:win",
    "build:dir": "npm run build:dir:server",
    "pretest": "npm run build",
    "test": "node --test",
    "precontents": "npm run build",
    "contents": "node scripts/refresh-contents.js",
    "prepacks:check": "npm run build",
    "packs:check": "node scripts/audit-packs.js",
    "prefetch:bg3le": "npm run build",
    "fetch:bg3le": "node scripts/fetch-bg3le.js",
    "notes": "node scripts/release-notes.mjs",
    "pree2e": "npm run build",
    "e2e": "node scripts/e2e-factory.js",
    "preverify-install": "npm run build",
    "verify-install": "node scripts/e2e-factory.js --verify-only"
  },
  "dependencies": {
    "steam-shortcut-editor": "^3.1.3"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
