{
  "name": "mod-sync-steamos",
  "version": "0.1.2",
  "private": true,
  "description": "Reusable mod-pack deployment for Windows and SteamOS. Mods only in v1.",
  "author": "Winde",
  "license": "MIT",
  "type": "commonjs",
  "main": "electron/main.js",
  "bin": {
    "modsync": "bin/modsync.js"
  },
  "scripts": {
    "start": "node bin/modsync.js",
    "electron": "electron .",
    "dev": "electron . --devtools",
    "build:linux": "electron-builder --linux AppImage",
    "build:dir": "electron-builder --dir",
    "test": "node --test",
    "contents": "node scripts/refresh-contents.js",
    "notes": "node scripts/release-notes.mjs",
    "e2e": "node scripts/e2e-factory.js",
    "verify-install": "node scripts/e2e-factory.js --verify-only"
  },
  "dependencies": {
    "steam-shortcut-editor": "^3.1.3"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  }
}
