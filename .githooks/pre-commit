#!/bin/sh
# Refuse to commit generated pack output. Recipes and code are the source.
set -e

staged=$(git diff --cached --name-only --diff-filter=ACM)

packs=$(printf '%s\n' "$staged" | grep -E '^packs/' || true)
if [ -n "$packs" ]; then
  echo "Refusing to commit generated pack output. Commit recipes/ and code instead:"
  printf '%s\n' "$packs"
  exit 1
fi

big=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  [ -f "$f" ] || continue
  size=$(wc -c <"$f" | tr -d ' ')
  if [ "$size" -gt 52428800 ]; then
    big="$big$f ($size bytes)\n"
  fi
done <<EOF
$staged
EOF

if [ -n "$big" ]; then
  printf "Refusing to commit files larger than 50 MB:\n%b" "$big"
  exit 1
fi
