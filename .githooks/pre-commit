#!/bin/sh
# Refuse to commit generated pack payloads or very large files.
# Allowed under packs/: <pack>/pack.json and <pack>/files.json only.
set -e

staged=$(git diff --cached --name-only --diff-filter=ACM)

payload=$(printf '%s\n' "$staged" | grep -E '^packs/[^/]+/(payload|tools|profiles|art)/' || true)
if [ -n "$payload" ]; then
  echo "Refusing to commit generated pack files:"
  printf '%s\n' "$payload"
  exit 1
fi

other=$(printf '%s\n' "$staged" | grep -E '^packs/' | grep -Ev '^packs/[^/]+/(pack\.json|files\.json)$' || true)
if [ -n "$other" ]; then
  echo "Only pack.json and files.json may be committed under packs/:"
  printf '%s\n' "$other"
  exit 1
fi

big=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  [ -f "$f" ] || continue
  size=$(wc -c <"$f" | tr -d ' ')
  if [ "$size" -gt 52428800 ]; then
    big="$big$f ($size bytes)\n"
  fi
done <<EOF
$staged
EOF

if [ -n "$big" ]; then
  printf "Refusing to commit files larger than 50 MB:\n%b" "$big"
  exit 1
fi
